/* Firefox theme generated by apply_theme.sh */
:root {
  --toolbar-bgcolor: ${BG} !important;
  --toolbar-color: ${FG} !important;
  --lwt-accent-color: ${ACCENT} !important;
  --lwt-text-color: ${FG} !important;
  --urlbar-bgcolor: ${BLACK} !important;
  --urlbar-text-color: ${FG} !important;
}

/* Optional: make tabs match */
.tab-background {
  background-color: ${BG} !important;
}

