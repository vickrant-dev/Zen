# Hyprland theme template
general {
    gaps_in = 5
    gaps_out = 10
    border_size = 2
    col.active_border = ${ACCENT_RGB} ${ACCENT2_RGB} 45deg
    col.inactive_border = rgba(89,89,89,0.8)
    layout = dwindle
}

decoration {
    rounding = 10
    blur {
        enabled = true
        size = 3
        passes = 1
    }
    shadow {
        enabled = true
        range = 4
        render_power = 3
        color = ${BLACK_RGBA}
    }
}
